{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sawtify-arabic-stt",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
